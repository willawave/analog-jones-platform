{
  "name": "analog-jones-platform",
  "version": "1.0.3",
  "scripts": {
    "ng": "ng",
    "build": "pnpm build:core && ng build $ANGULAR_PROJECT_NAME",
    "build:core": "ng build core",
    "build:public": "pnpm build:core && ng build public-app",
    "build:admin": "pnpm build:core && ng build admin-app",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm build:core && concurrently --names public,admin,core \"ng test public-app\" \"ng test admin-app\" \"ng test core\"",
    "test:public": "pnpm build:core && ng test public-app",
    "test:admin": "pnpm build:core && ng test admin-app",
    "test:core": "ng test core",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:public-bundle": "node scripts/check-public-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr:public-app": "node dist/public-app/server/server.mjs",
    "serve:ssr:admin-app": "node dist/admin-app/server/server.mjs",
    "e2e": "firebase emulators:exec --import=./seed-data \"playwright test\"",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run test/firestore-rules.spec.ts\"",
    "emulators:save": "firebase emulators:export ./seed-data",
    "emulators:start": "firebase emulators:start",
    "emulators:stop": "lsof -ti:4000,4200,4300,4400,8080,9099,9150 | xargs kill -9 2>/dev/null || true",
    "dev:public": "rm -rf dist/core && concurrently --names core,emulators,app --prefix-colors yellow,blue,green --kill-others-on-fail \"ng build core --watch\" \"firebase emulators:start --import=./seed-data\" \"wait-on dist/core/fesm2022/aj-core.mjs && ng serve public-app\"",
    "dev:admin": "rm -rf dist/core && concurrently --names core,emulators,app --prefix-colors yellow,blue,green --kill-others-on-fail \"ng build core --watch\" \"firebase emulators:start --import=./seed-data\" \"wait-on dist/core/fesm2022/aj-core.mjs && ng serve admin-app\"",
    "dev:all": "rm -rf dist/core && concurrently --names core,emulators,public,admin --prefix-colors yellow,blue,green,magenta --kill-others-on-fail \"ng build core --watch\" \"firebase emulators:start --import=./seed-data\" \"wait-on dist/core/fesm2022/aj-core.mjs && ng serve public-app --port 4200\" \"wait-on dist/core/fesm2022/aj-core.mjs && ng serve admin-app --port 4300\"",
    "release": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "probe:write-defenses": "node scripts/probe-write-defenses.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@ngrx/signals": "^22.0.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "firebase": "^12.14.0",
    "marked": "^18.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.59.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.42",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.19.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.4",
    "playwright-ng-schematics": "^22.1.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
